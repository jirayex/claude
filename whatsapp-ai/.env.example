# ==== WhatsApp Business Cloud API (Meta) ====
# developers.facebook.com > Seu App > WhatsApp > Configuração da API
WHATSAPP_TOKEN=coloque_seu_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Qualquer texto que você inventar; o mesmo vai no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=minha_senha_de_verificacao
# App Secret (Configurações do app > Básico). Usado para validar que o webhook veio da Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# ==== IA ====
# Ordem de preferência. Se o primeiro falhar (limite do dia, fora do ar), usa o próximo.
# Padrão 100% grátis: Gemini principal + Groq reserva.
# Para usar o Claude (pago, pré-pago): LLM_PROVIDERS=claude,gemini,groq e preencha ANTHROPIC_API_KEY
LLM_PROVIDERS=gemini,groq

# Claude (Anthropic) — OPCIONAL e PAGO por uso: https://console.anthropic.com
# Deixe o Auto-reload DESLIGADO no Billing para nunca ser cobrado além do crédito comprado.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# low | medium | high — low é rápido e barato, ideal para conversa
CLAUDE_EFFORT=low

# IAs gratuitas:
#   groq   -> https://console.groq.com/keys          (grátis, muito rápido)
#   gemini -> https://aistudio.google.com/apikey      (grátis, com limites diários)
#   ollama -> roda no seu computador, 100% grátis e ilimitado (https://ollama.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Transcrição de áudios (usa Whisper grátis da Groq; deixe vazio para desativar)
TRANSCRIBE_AUDIO=true

# ==== Comportamento ====
PORT=3000
BOT_NAME=Ana
COMPANY_NAME=Minha Empresa
# Número(s) do dono/atendente humano que recebem aviso quando o cliente pede humano (só dígitos, com DDI)
OWNER_NUMBERS=5511999999999
# Segundos esperando o cliente terminar de digitar várias mensagens antes de responder
DEBOUNCE_SECONDS=6
# Velocidade de "digitação" simulada (caracteres por segundo)
TYPING_CPS=18
# Horário de atendimento (vazio = 24h). Formato HH:MM-HH:MM, fuso abaixo
BUSINESS_HOURS=
TIMEZONE=America/Sao_Paulo
# Quantas mensagens do histórico a IA lembra por cliente
HISTORY_LIMIT=30
